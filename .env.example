# FluentAI environment configuration
# Copy this file to .env and fill in your values.
# Obtain a free Gemini API key at: https://aistudio.google.com/

# --- Required ---
GEMINI_API_KEY=
DATABASE_URL=

# --- Optional ---
# CORS: comma-separated allowed origins (default: ["*"] — open for local dev).
# Set to specific origins in production, e.g. ["https://yourdomain.com"].
# When set to anything other than ["*"], credentials are sent with requests.
# CORS_ORIGINS=["https://yourdomain.com"]

# Access token: protects all /api routes when non-empty.
# Leave empty to disable auth (local dev default).
APP_ACCESS_TOKEN=

# Obsidian vault path: write session notes to your vault when set.
# Leave empty to disable vault integration.
# VAULT_ROOT=/path/to/your/ObsidianVault
VAULT_ROOT=
